# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# From @BotFather after /newbot
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (NOT your @username). Get it from @userinfobot.
# This is the ONLY account the bot will respond to; everyone else is ignored
# in silence.
AUTHORIZED_USER_ID=

# Log the numeric id of rejected senders. Message content is never logged
# either way. Default false.
LOG_REJECTED_IDS=false

# ---------------------------------------------------------------------------
# Vast.ai
# ---------------------------------------------------------------------------
# https://cloud.vast.ai/account/ -> API keys
VAST_API_KEY=
VAST_API_BASE=https://console.vast.ai/api/v0

# Docker image for the rented GPU. The stock PyTorch image below works but
# re-downloads dependencies and ~60 GB of model weights on EVERY job, which
# usually costs more than the render. Build the Dockerfile at the root of this
# repo, push it to a registry, and point this at it instead.
VAST_IMAGE=pytorch/pytorch:2.4.0-cuda12.1-cudnn9-runtime

VAST_MIN_VRAM_GB=24
VAST_MAX_DPH=1.50
VAST_DISK_GB=100
VAST_GPU_NAMES=RTX_3090,RTX_4090,A100_PCIE,A100_SXM4

# Whoever hosts the machine your container runs on has root on it, and can
# therefore read your input image, your prompt and the rendered video while the
# job runs. These two settings choose who that is; neither removes the access.
#   VAST_VERIFIED_ONLY   hosts Vast has vetted (their own CLI defaults to this)
#   VAST_DATACENTER_ONLY datacenter operators only, not individuals at home
# Narrowing costs money — fewer offers, higher floor price.
VAST_VERIFIED_ONLY=true
VAST_DATACENTER_ONLY=false

# Every instance this bot rents carries this label, so orphans from a crash can
# be found and destroyed at startup. Do not share it with other tooling.
VAST_LABEL=i2v-bot

# ---------------------------------------------------------------------------
# SSH (written by setup.sh)
# ---------------------------------------------------------------------------
SSH_KEY_PATH=./secrets/vast_ed25519
SSH_PUBLIC_KEY_PATH=./secrets/vast_ed25519.pub

# ---------------------------------------------------------------------------
# Model and runtime
# ---------------------------------------------------------------------------
MODEL_ID=Wan-AI/Wan2.2-I2V-A14B-Diffusers
WORK_DIR=./jobs
INSTANCE_BOOT_TIMEOUT=900
JOB_TIMEOUT=7200
